import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-SOMEIP_deployment_spec.fdepl"
import "gpu.fidl"

define org.genivi.commonapi.someip.deployment for interface omnimetron.gpu.GpuUsageData {
    SomeIpServiceID = 4660

    broadcast notifyGpuUsageDataChange {
        SomeIpEventID = 38022
        SomeIpEventGroups = { 7006 }
        SomeIpReliable = false
    }

    method requestGpuUsageData {
        SomeIpMethodID = 1
        SomeIpReliable = false
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service {
    instance omnimetron.gpu.GpuUsageData {
        InstanceId = "omnimetron.gpu.GpuUsageData"
        SomeIpInstanceID = 22136
        SomeIpUnicastAddress = "127.0.0.1"
        SomeIpReliableUnicastPort   = 30500
        SomeIpUnreliableUnicastPort = 30499
    }
}